{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "perps-prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8766", "--directory", "prototype"],
      "port": 8766
    },
    {
      "name": "redline3d",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "4000", "--strictPort", "--host"],
      "cwd": "redline3d",
      "port": 4000
    },
    {
      "name": "perps-server",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "REAL_MONEY_ENABLED=false CORS_ORIGINS=http://localhost:4000 SIGNUP_FAUCET=true DEV_ENDPOINTS=true PORT=8080 NODE_ENV=development npx tsx src/index.ts"],
      "cwd": "server",
      "port": 8080
    }
  ]
}
