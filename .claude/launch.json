{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "perps-prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8766", "--directory", "prototype"],
      "port": 8766
    },
    {
      "name": "journey",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8767", "--directory", "journey"],
      "port": 8767
    },
    {
      "name": "redline3d",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "npm run dev -- --host"],
      "cwd": "redline3d",
      "port": 4000,
      "autoPort": true
    },
    {
      "name": "redline3d-devwallet",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "VITE_WALLET=dev npm run dev -- --port 4100 --strictPort --host"],
      "cwd": "redline3d",
      "port": 4100
    },
    {
      "name": "perps-server",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "LAN_IP=$(ipconfig getifaddr en0 2>/dev/null || true); REAL_MONEY_ENABLED=false CORS_ORIGINS=\"http://localhost:4000,http://127.0.0.1:4000,http://localhost:4100,http://127.0.0.1:4100${LAN_IP:+,http://$LAN_IP:4000,http://$LAN_IP:4100}\" SIGNUP_FAUCET=true DEV_ENDPOINTS=true PORT=8080 NODE_ENV=development npx tsx src/index.ts"],
      "cwd": "server",
      "port": 8080
    }
  ]
}
