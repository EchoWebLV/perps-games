VITE_API_BASE=https://redline-server-production-f413.up.railway.app
VITE_CRATE_TREASURY_PUBKEY=53RbWfEX4iyikHQbySdyuNoL1eDmgm8V35s9XLSJ3g5r
# Chain rail this build talks to (src/evm/rail.ts). evm = Robinhood Chain, the live money rail;
# solana is parked but still buildable. Pinned explicitly so the rail is readable, not inferred.
VITE_CHAIN_RAIL=evm
# Robinhood Chain network (src/evm/chain.ts): testnet = chain id 46630 (play money);
# anything else resolves to mainnet = 4663. Dev builds point at play money.
VITE_EVM_CHAIN=testnet
# ERC-20 USDC contract on the network above. Deploy-time truth — filled in at deploy, never
# guessed here. A wrong token address sends deposits nowhere, so blank beats a plausible guess.
VITE_EVM_USDC_ADDRESS=
