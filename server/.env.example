# Copy to server/.env and fill in. server/src/env.ts is the source of truth — it validates every
# var below and fails the boot closed on a bad one. Everything here is a placeholder, never a real
# credential. Vars left commented out are the ones where a BLANK value is worse than an absent one
# (zod sees "" as present and fails the min-length / regex / positive-number check).
# This documents the boot + real-money set, not every knob; read env.ts for the rest.

# --- Core boot ---
# Postgres connection (Railway provides this in production).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/perps
PORT=8080
# development | test | production. production additionally REQUIRES SESSION_SECRET.
NODE_ENV=development
# Session cookie signing key, min 32 chars. Generate with `openssl rand -hex 32`.
# SESSION_SECRET=change-me-to-32-plus-random-characters
# Comma-separated browser origins allowed to call the API. Every origin the client is served from
# must be listed; a missing one fails CORS at request time, not at boot.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost,capacitor://localhost
# enable /v1/dev/* seeding endpoints (NEVER set in production)
DEV_ENDPOINTS=true
# Password-less dev sign-in. DEFAULTS TO TRUE when unset — set it to "false" in production.
DEV_AUTH=false

# --- Oracle ---
# Pyth Terminal key — required for live Hermes prices after 2026-08-26. Unset → HUD stays SIM.
# Server-side only: it must never reach the client bundle as a VITE_ var.
# PYTH_API_KEY=

# --- Real money ---
# Master switch. "true" turns on the money rail and makes the CHAIN_FAMILY vars below REQUIRED.
REAL_MONEY_ENABLED=false
# Second switch cash (real-money) rounds need. Even with both on, boot still fails closed until an
# autonomous settler is wired (assertRoundSettlerForStake).
CASH_SETTLER_ENABLED=false
# How often the settler sweeps every open round for a terminal outcome — this is the worst-case lag
# between a round becoming liquidated/capped/expired and it actually settling. Keep it tight.
ROUND_SETTLE_POLL_MS=1000
# Shared operator secret guarding the admin withdrawal-approval endpoint, min 16 chars. Unset =>
# the admin surface is disabled AND withdrawals refuse to reserve (no approval path strands funds).
# ADMIN_API_SECRET=

# --- Chain selection ---
# Which chain rail the money vars describe. Defaults to evm (Robinhood Chain), the live rail.
# Existing Solana deployments MUST set this explicitly or boot fails closed on the evm vars.
CHAIN_FAMILY=evm

# --- EVM rail (Robinhood Chain). Required when REAL_MONEY_ENABLED=true and CHAIN_FAMILY=evm. ---
# RPC and chain id are a matched pair — a mismatch means you are pointed at the wrong network:
#   testnet   46630   https://rpc.testnet.chain.robinhood.com
#   mainnet    4663   https://rpc.mainnet.chain.robinhood.com
# EVM_RPC_URL=https://rpc.testnet.chain.robinhood.com
# EVM_CHAIN_ID=46630
# Secondary endpoint used when the primary is unreachable.
# EVM_RPC_URL_FALLBACK=
# USDC token contract. Stored lowercased. There is deliberately NO decimals var: boot calls
# decimals() on chain and refuses to start unless it reports 6 (server/src/money/usdc.ts).
# EVM_USDC_ADDRESS=0x0000000000000000000000000000000000000000
# Treasury address deposits are swept to and withdrawals are paid from. Stored lowercased.
# EVM_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
# Treasury private key (0x + 64 hex). Required only for the withdraw send leg; never commit it.
# Setting it REQUIRES EVM_TREASURY_ADDRESS — boot derives the address and asserts the two match.
# EVM_TREASURY_SECRET=
# Confirmations a deposit needs before it is credited. Blank falls back to 12, never 0.
# EVM_CONFIRMATIONS=12
# Widest block span one eth_getLogs deposit scan may cover. Blank falls back to 10000.
# If your RPC caps eth_getLogs BELOW this, every scan errors and the deposit cursor freezes
# (deposits stop being credited) — set this smaller than the provider's limit.
# EVM_MAX_BLOCK_RANGE=10000
