# Postgres connection (Railway provides this in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/perps
PORT=8080
# enable /v1/dev/* seeding endpoints (NEVER set in production)
DEV_ENDPOINTS=true
# Pyth Terminal key — required for live Hermes prices after 2026-08-26. Unset → HUD stays SIM.
# PYTH_API_KEY=

# Which chain rail the money vars describe. Defaults to evm (Robinhood Chain).
# Existing Solana deployments MUST set this explicitly or boot fails closed.
CHAIN_FAMILY=solana

# --- EVM rail (Robinhood Chain). Required when REAL_MONEY_ENABLED=true and CHAIN_FAMILY=evm. ---
# JSON-RPC endpoint for the chain.
# EVM_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Secondary endpoint used when the primary is unreachable.
# EVM_RPC_URL_FALLBACK=
# Chain id the RPC must report; a mismatch means you are pointed at the wrong network.
# EVM_CHAIN_ID=46630
# USDC token contract. Stored lowercased.
# EVM_USDC_ADDRESS=0x0000000000000000000000000000000000000000
# Treasury address deposits are swept to and withdrawals are paid from. Stored lowercased.
# EVM_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
# Treasury private key (0x + 64 hex). Required only for the withdraw send leg; never commit it.
# EVM_TREASURY_SECRET=
# Confirmations a deposit needs before it is credited. Blank falls back to 12, never 0.
# EVM_CONFIRMATIONS=12
